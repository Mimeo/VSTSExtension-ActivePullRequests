    "loader-utils": "^1.4.2",
    "rimraf": "^6.0.1",
    "sass": "^1.104.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "tfx-cli": "^0.23.5",
    "ts-loader": "^9.5.4",
    "tslint": "^6.1.3",
    "typescript": "^5.9.2",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "azure-devops-extension-api": "^1.158.0",
    "azure-devops-extension-sdk": "^2.0.11",
    "azure-devops-ui": "^1.160.4",
