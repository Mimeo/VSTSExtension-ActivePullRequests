{
  "scripts": {
    "build": "npm run lint && npm run clean && npm run webpack",
    "webpack": "webpack --progress --config webpack.config.js --output-path ./dist --mode production",
    "postbuild": "npm run package",
    "package": "tfx extension create --rev-version --manifest-globs ./mimeo-devops-extension.json",
    "gallery-publish": "node scripts/publish-extension.js",
    "clean": "rimraf ./dist && rimraf --glob ./*.vsix",
    "lint": "tslint -c tslint.json 'src/*.ts'"
  },
  "devDependencies": {
    "@types/react": "^16.9.3",
    "@types/react-dom": "^16.9.1",
    "css-loader": "^7.1.5",
