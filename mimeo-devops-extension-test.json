{
  "manifestVersion": 1,
  "id": "mimeo-active-pull-requests-dev",
  "version": "0.1.1",
  "name": "All Active Pull Requests (Private Test)",
  "scopes": ["vso.code", "vso.code_status", "vso.build", "vso.profile"],
  "description": "Private test build of the extension that shows all active pull requests across all repos in a project.",
  "public": false,
  "publisher": "mimeo-vs-marketplace",
  "icons": {
    "default": "static/images/pullRequest.png"
  },
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "demands": [
    "api-version/5.0"
  ],
  "tags": [
    "pullrequest",
    "pullrequests",
    "pull-request",
    "pull-requests",
    "code",
    "code-review",
    "private-test"
  ],
  "screenshots": [
    {
      "path": "static/images/Screenshot.png"
    }
  ],
  "content": {
    "license": {
      "path": "license.md"
    },
    "details": {
      "path": "overview.md"
    }
  },
  "links": {
    "learn": {
      "uri": "https://github.com/mimeo/vstSExtension-ActivePullRequests/"
    },
    "support": {
      "uri": "https://github.com/mimeo/vstSExtension-ActivePullRequests/issues"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/mimeo/VSTSExtension-ActivePullRequests/"
  },
  "branding": {
    "color": "#3F99D3",
    "theme": "light"
  },
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "static",
      "addressable": true
    }
  ],
  "categories": [
    "Azure Repos"
  ],
  "contributions": [
    {
      "id": "active-pull-requests-extension-hub",
      "targets": ["ms.vss-code-web.code-hub-group"],
      "type": "ms.vss-web.hub",
      "description": "View all active pull requests across all repos in a team project.",
      "properties": {
        "name": "All Active Pull Requests (Private Test)",
        "order": 100,
        "uri": "static/index.html",
        "icon": {
          "light": "static/images/pullRequest_light.png",
          "dark": "static/images/pullRequest_dark.png"
        }
      }
    }
  ]
}
